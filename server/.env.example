# Server
PORT=4000

# Sandbox Mode: 'pty' (local shell) or 'docker' (Docker containers)
SANDBOX_MODE=pty

# JWT Secret (change in production!)
JWT_SECRET=CHANGE_ME_generate_a_random_64char_string

# AI Hub URL
AI_HUB_URL=http://localhost:5000

# Docker (only needed if SANDBOX_MODE=docker)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# MongoDB (Phase 2+)
# MONGO_URI=mongodb://localhost:27017/opsacademy

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
