# Server
PORT=4000
NODE_ENV=development

# Sandbox mode
#   pty    - a shell on this machine, with NO isolation. Local development only.
#   docker - one locked-down container per student. Use this for real users.
SANDBOX_MODE=pty

# JWT secret. Required in production (the server refuses to start without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_random_64char_string

# Optional: separate key for signing certificates (defaults to one derived from JWT_SECRET)
# CERT_SECRET=

# AI Hub URL, and the shared secret both services use (set the same value in ai-hub/.env)
AI_HUB_URL=http://localhost:5005
# AI_HUB_TOKEN=
# AI_HUB_TIMEOUT_MS=4000        # raise to ~15000 if the hub's LLM mentor is enabled

# Where accounts, progress and certificates are stored (a JSON file).
# Point this at a persistent volume in production.
# DATA_DIR=./.data
# json (default): one file, rewritten on every save. sqlite: one row per
# document, using the SQLite built into Node 22. An existing store.json is
# imported the first time sqlite is used.
# STORE_DRIVER=json

# Browser origins allowed to call the API and open terminals, comma separated.
# Unset = any origin (auth is a bearer token, not a cookie).
# CORS_ORIGINS=https://your-app.vercel.app

# Email (password reset and email confirmation links).
# Without RESEND_API_KEY nothing is sent: links are written to the server log,
# and outside production the API also returns them so the flow can be tried.
# RESEND_API_KEY=
# MAIL_FROM=OpsAcademy <no-reply@your-domain.example>
# The web app's public URL, used to build the links in emails.
# APP_URL=https://your-app.vercel.app

# Operator endpoints (/api/admin/*) exist only when this is set.
# ADMIN_TOKEN=
# Require `Authorization: Bearer <token>` on /metrics.
# METRICS_TOKEN=

# Docker mode
DOCKER_SOCKET_PATH=/var/run/docker.sock
# SANDBOX_IMAGE=opsacademy-sandbox:latest
# SANDBOX_NETWORK=none          # none | internal | bridge
# SANDBOX_MEMORY_MB=256
# SANDBOX_CPUS=0.5
# SANDBOX_PIDS_LIMIT=128
# SANDBOX_HOME_MB=64

# Limits
# SANDBOX_POOL_SIZE=3
# ENABLE_SANDBOX_POOL=true
# SANDBOX_MAX_PER_USER=2
# SANDBOX_MAX_TOTAL=25
# SANDBOX_MAX_MINUTES=30
# SANDBOX_IDLE_MINUTES=15
