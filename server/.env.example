# Server
PORT=4000
NODE_ENV=development

# Sandbox mode
#   pty    - a shell on this machine, with NO isolation. Local development only.
#   docker - one locked-down container per student. Use this for real users.
SANDBOX_MODE=pty

# Sign-in is Supabase Auth. Production needs the project URL and publishable key (the gateway verifies sessions with
# them). SUPABASE_SECRET_KEY is server-only: it lets the gateway make, reset and ban Lab ID accounts.
# For local development leave them unset-ish and run `npm run auth` (a local stand-in, port 54321), then use:
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=local-development-key
# SUPABASE_SECRET_KEY=local-development-key

# Signs certificates. Required in production (the server refuses to start without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CERT_SECRET=

# AI Hub URL, and the shared secret both services use (set the same value in ai-hub/.env)
AI_HUB_URL=http://localhost:5005
# AI_HUB_TOKEN=
# AI_HUB_TIMEOUT_MS=10000       # must stay above the hub's LLM_TIMEOUT_SECONDS (default 8)

# Browser origins allowed to call the API and open terminals, comma separated.
# Unset = any origin (auth is a bearer token, not a cookie).
# CORS_ORIGINS=https://your-app.vercel.app

# The web app's public URL.
# APP_URL=https://your-app.vercel.app

# Verified email(s) that are platform admins (operator page /admin). More: `npm run grant-role`.
# PLATFORM_ADMIN_EMAILS=
# Require `Authorization: Bearer <token>` on /metrics.
# METRICS_TOKEN=

# Docker mode
DOCKER_SOCKET_PATH=/var/run/docker.sock
# SANDBOX_IMAGE=opsacademy-sandbox:latest
# SANDBOX_NETWORK=none          # none | internal | bridge
# SANDBOX_MEMORY_MB=256
# SANDBOX_CPUS=0.5
# SANDBOX_PIDS_LIMIT=128
# SANDBOX_HOME_MB=64

# Limits
# SANDBOX_POOL_SIZE=3
# ENABLE_SANDBOX_POOL=true
# SANDBOX_MAX_PER_USER=2
# SANDBOX_MAX_TOTAL=25
# SANDBOX_MAX_MINUTES=30
# SANDBOX_IDLE_MINUTES=15

# ── Database (Postgres / Supabase) ──────────────────────────
# Set DATABASE_URL to use Postgres (required in production). Without it the gateway keeps
# everything in memory, which is fine for local development and loses data on restart.
# DATABASE_URL=postgres://postgres.<ref>:<password>@<pooler-host>:6543/postgres   # transaction pooler
# MIGRATION_DATABASE_URL=postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres   # direct, for npm run migrate
# DATABASE_POOL_SIZE=10
# DATABASE_CA_FILE=/path/to/supabase-ca.pem    # optional: verify the server certificate
