{
  "name": "opsacademy-server",
  "version": "1.0.0",
  "description": "OpsAcademy API Gateway \u2014 Terminal streaming, sandbox management, and lab orchestration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "labs:validate": "node scripts/validate-labs.js",
    "labs:audit": "node scripts/audit-labs.js",
    "bench": "node scripts/benchmark.js",
    "loadtest": "node scripts/loadtest.js",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "lint": "oxlint",
    "labs:audit:check": "node scripts/audit-labs.js --check",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "grant-role": "node scripts/grant-role.js",
    "test:db": "jest tests/migrator.test.js tests/schema.test.js tests/repositories.postgres.test.js tests/legacyImport.test.js --runInBand --coverage=false",
    "test:pg": "TEST_REPOS=postgres jest --runInBand --coverage=false --testPathIgnorePatterns migrator schema repositories.postgres legacyImport",
    "migrate:data": "node scripts/migrate-data.js"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dockerode": "^4.0.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-pty": "^1.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "oxlint": "^1.87.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "@supabase/supabase-js": "^2.118.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 20000,
    "collectCoverageFrom": [
      "lib/**/*.js",
      "middleware/**/*.js",
      "routes/**/*.js",
      "services/**/*.js",
      "repositories/**/*.js",
      "jobs/**/*.js",
      "app.js",
      "!lib/migrator.js",
      "!lib/legacyImport.js",
      "!repositories/postgres.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 77,
        "functions": 81,
        "lines": 87
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup-db.js"
    ]
  }
}
