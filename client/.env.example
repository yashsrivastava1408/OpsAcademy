# API origin the browser talks to (empty or /api for same-origin deployments)
VITE_API_URL=http://localhost:4000

# Sign-in. Leave VITE_AUTH_MODE unset to use the gateway's own sign-in (local development and CI).
# Set it to "supabase" for Supabase Auth (session in memory + HttpOnly cookie). The gateway must have
# LEGACY_AUTH=off at the same time once the cutover is done; see docs/adr/0003 and docs/runbooks/auth-cutover.md.
# VITE_AUTH_MODE=supabase
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<publishable key>
# College single sign-on buttons (providers must be enabled in Supabase): google, azure
# VITE_SSO_PROVIDERS=google,azure
