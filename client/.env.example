# API origin the browser talks to (empty or /api for same-origin deployments)
VITE_API_URL=http://localhost:4000

# Sign-in. With no Supabase settings the client uses the gateway's own sign-in (local development and CI only; the gateway
# refuses it in production). With the two settings below it signs in through Supabase Auth (session in memory + HttpOnly
# cookie). See docs/adr/0003 and docs/runbooks/auth-cutover.md.
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<publishable key>
# College single sign-on buttons (providers must be enabled in Supabase): google, azure
# VITE_SSO_PROVIDERS=google,azure
