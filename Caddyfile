{
    email {$ACME_EMAIL:admin@example.com}
    admin off
    # A client that connects to a bare IP sends no server name (SNI). Behind NAT (AWS) Caddy would
    # then look for a certificate for the machine's private address and fail the handshake.
    default_sni {$DOMAIN:localhost}
}

# TLS mode. A real domain uses automatic Let's Encrypt certificates (the default). Let's Encrypt cannot
# issue certificates for a bare IP address, so an IP-only deployment sets TLS_SNIPPET=tls_internal
# (a self-signed certificate: traffic is encrypted, browsers show a warning). Use a domain for real users.
(tls_acme) {
    header -Server
}
(tls_internal) {
    tls internal
}

{$DOMAIN:localhost} {
    import {$TLS_SNIPPET:tls_acme}

    # Modern compression for text, JSON and scripts
    encode zstd gzip

    # Terminal WebSocket connections (long-lived streams)
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle /api/terminal* {
        reverse_proxy server:4000 {
            transport http {
                response_header_timeout 600s
                dial_timeout 10s
            }
        }
    }

    # API Gateway REST endpoints
    handle /api/* {
        reverse_proxy server:4000
    }

    # Prometheus metrics endpoint
    handle /metrics {
        reverse_proxy server:4000
    }

    # React Frontend Client SPA
    handle {
        reverse_proxy client:80
    }

    # Security Headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
}
