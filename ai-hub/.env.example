PORT=5005

# Shared secret with the gateway (same value as AI_HUB_TOKEN in server/.env).
# Set it whenever the hub is reachable from outside your private network.
# AI_HUB_TOKEN=

# Optional sentence embeddings for retrieval: pip install -r requirements-semantic.txt
# auto = use them if that package is installed. The first start downloads the
# model (about 90 MB) and the hub then needs about 450 MB more memory.
# SEMANTIC_SEARCH=auto      # auto | on | off
# MODEL_CACHE_DIR=~/.cache/opsacademy-models

# Optional LLM: writes the mentor's hints and judges interview answers by meaning.
# Without a key the hub answers from rules and retrieval.
# ANTHROPIC_API_KEY=
# LLM_ENABLED=auto          # auto | on | off
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low
# LLM_TIMEOUT_SECONDS=12    # raise AI_HUB_TIMEOUT_MS on the gateway to match
