# OpsAcademy Production Environment Configuration
# Copy this file to .env.production on your EC2 instance:
#   cp .env.production.example .env.production

# ── Domain & SSL (Managed by Caddy) ─────────────────────────
DOMAIN=opsacademy.example.com
ACME_EMAIL=admin@example.com

# ── Gateway Cryptographic Secrets ───────────────────────────
# Generate with: openssl rand -hex 48
JWT_SECRET=replace_with_64_character_hex_string
# Generate with: openssl rand -hex 32
CERT_SECRET=replace_with_32_character_hex_string
# Generate with: openssl rand -hex 24
AI_HUB_TOKEN=replace_with_24_character_hex_string
# Verified email(s) of the first platform admin (operator page at /admin), comma separated.
# More admins and college roles: `npm run grant-role` in server/
PLATFORM_ADMIN_EMAILS=
# Optional prometheus metrics endpoint bearer token
METRICS_TOKEN=

# ── Persistence & Store ─────────────────────────────────────

# ── Email Service (Resend.com) ──────────────────────────────
# Sign up at https://resend.com (free 3,000 emails/month)
RESEND_API_KEY=
MAIL_FROM=OpsAcademy <noreply@opsacademy.example.com>
APP_URL=https://opsacademy.example.com
CLIENT_URL=https://opsacademy.example.com
CORS_ORIGINS=https://opsacademy.example.com

# ── AI Hub & LLM Mentorship ─────────────────────────────────
# Leave empty for deterministic rule-based mentor (0 API cost)
# Or provide Anthropic Claude or Groq API keys for LLM mentorship
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=auto
AI_HUB_TIMEOUT_MS=10000
WITH_SEMANTIC=true

# ── Sandbox Capacity Tuning for EC2 ─────────────────────────
# t3.medium (2 vCPU, 4GB RAM): SANDBOX_MAX_TOTAL=25, SANDBOX_POOL_SIZE=3
# t3.large (2 vCPU, 8GB RAM):  SANDBOX_MAX_TOTAL=50, SANDBOX_POOL_SIZE=5
# c6i.xlarge (4 vCPU, 8GB RAM): SANDBOX_MAX_TOTAL=75, SANDBOX_POOL_SIZE=8
# Pilot (~40 concurrent students, plus headroom) on a t3.large or bigger:
SANDBOX_MAX_TOTAL=45
SANDBOX_POOL_SIZE=5
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5

# ── Campus network (pilot) ──────────────────────────────────
# A whole college can share one public IP. Sign-in and guest limits are
# multiplied (default x15: 20 -> 300 sign-ins/min) for these addresses or
# CIDR ranges. Comma separated; leave empty to apply the base limits everywhere.
CAMPUS_IPS=
CAMPUS_RATE_MULTIPLIER=15

# ── Database (Supabase Postgres) ────────────────────────────
# Gateway and worker: the TRANSACTION POOLER string (Project Settings -> Database -> Connection pooling).
DATABASE_URL=
# Migrations and the worker: the SESSION pooler string (port 5432), because they use advisory locks.
# (Supabase's "Direct connection" is IPv6-only on the Free plan; the session pooler works from IPv4 hosts.)
# Falls back to DATABASE_URL when empty, which breaks the locks behind the transaction pooler.
MIGRATION_DATABASE_URL=
DATABASE_POOL_SIZE=10

# ── TLS ─────────────────────────────────────────────────────
# With a real DOMAIN, leave this as is: Caddy gets a Let's Encrypt certificate automatically.
# With only an IP address (DOMAIN=<ip>), set tls_internal: Let's Encrypt cannot certify an IP, so Caddy
# uses a self-signed certificate (encrypted, but browsers warn). Do not use that for real students.
TLS_SNIPPET=tls_acme
